<% layout("layouts/boilerplate") %>
<div class="form-page">
    <h1 class="page-title">Sign up</h1>
    <form action="/signup" method="POST" class="form-card">
    
     <div class="mb-3">
    <label for="username" class="form-label">Username
            </label>

            <input
                type="text"
                id="username"
                name="username"
                class="form-control"
                required
            >
        </div>
        <div class="mb-3">
            <label for="email" class="form-label">
                Email
            </label>

            <input
                type="email"
                id="email"
                name="email"
                class="form-control"
                required
            >
        </div>
        <div class="mb-3">
            <label for="password" class="form-label">
                Password
            </label>

            <input
                type="password"
                id="password"
                name="password"
                class="form-control"
                required
            >
        </div>

        <button type="submit" class="btn btn-dark">
            Sign Up
        </button>

    </form>
</div>