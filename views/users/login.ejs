<% layout("layouts/boilerplate") %>

<div class="form-page">

    <h1 class="page-title">Login</h1>

    <form action="/login" method="POST" class="form-card">

        <div class="mb-3">
            <label for="username" class="form-label">
                Username
            </label>

            <input
                type="text"
                id="username"
                name="username"
                class="form-control"
                required
            >
        </div>
        <div class="mb-3">
            <label for="password" class="form-label">
                Password
            </label>

            <input
                type="password"
                id="password"
                name="password"
                class="form-control"
                required
            >
        </div>
        <button type="submit" class="btn btn-primary">
            Login
        </button>

    </form>

</div>

