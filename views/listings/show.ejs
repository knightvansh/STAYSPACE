 <% layout("layouts/boilerplate") %>
  <body>

   <div class="row" mt="3">
    <div class="col col-10 offset-2">
    <h3>Listing Details:</h3>
    </div>

 <!-- Listing Card -->
    <div class="col-10 offset-1 my-2 mb-4">
            <img
             src="<%= listing.image && listing.image.url ? listing.image.url : 'https://via.placeholder.com/800x400?text=No+Image '%>"
             class="card-img-top object-fit-cover show-img"
             alt="Listing Image" />
                <!-- Listing Card Body  -->
            <div class="card-body mx-2">
                <p class="card-text"><b><h3><%=listing.title %></h3></b></p>
                <p class="card-text text-light-emphasis mt-2"><%= listing.description %></p>
                <p class="card-text">&#8377; <%= listing.price != null ? listing.price.toLocaleString("en-IN") : "N/A" %></p>
                <p class="card-text"><%=listing.location%>, <%=listing.country%>.</p>
             </div>
         </div>

  </div>
<div class="col-1">
<a href="/listings/<%=listing._id %>/edit" class="btn btn-dark"> Edit </a>
</div>
<br>
  <div class="col1">
<form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
 <button type="submit" " class="btn btn-dark">Delete </button>
</form>
  </div>


  <!-- review -->
   <hr />
     <h4 class="fs-4"><b>Rating and reviews</b></h4>
  <form action="">
  <div class="mb-3 mt-3" >
    <div>
   <label  class="form-label fw-bold" for="rating">RATING</label>
   <input type="range" min="1" max="5" id="rating" name="review[rating]">
   </div>

  <div>
   <label for="Comments" class="form-label fw-bold">Comments</label>
   <textarea name="review[comment]" id="cmment" cols="30" rows="5" class="form-control"></textarea>
 </div>

  <button class="btn btn-outline- btn-dark">Submit</button>
  </form>


</body>