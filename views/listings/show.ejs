 <% layout("layouts/boilerplate") %>
<div class="listing-detail">
  <h1 class="page-title">Listing Details</h1>
 <!-- Listing Card -->
     <script>
  const listing = <%- JSON.stringify(listing) %>;
     </script>
  <div class="listing-detail-card">
    <img
      src="<%= listing.image && listing.image.url ? listing.image.url : 'https://via.placeholder.com/800x400?text=No+Image '%>"
     class="show-img"
     alt="Listing Image" />
    <div id="map" class="listing-map"></div>
          <!-- Listing Card Body  -->
    <div class="card-body">
       <h2 class="listing-title">
                        <b><%= listing.title %></b>
        </h2>
      
       <p class="owner-label">
            <b>Hosted by <%= listing.owner && listing.owner.username ? listing.owner.username : "StaySpace host" %></b>
       </p>

       <p class="listing-description mt-2">
                        <%= listing.description %>
        </p>        
       <p class="card-text">&#8377; <%= listing.price != null ? listing.price.toLocaleString("en-IN") : "N/A" %></p>
       <p class="card-text"><%= listing.location %>, <%= listing.country %>.</p>

   <!-- Load  map logic AFTER data-->
<script src="/js/map.js"></script>   
   </div>
 </div>

<% if (currUser) { %>
    <form id="booking-date-form" class="row g-3 mt-3">
      <div class="col-12 col-sm-6">
        <label for="check-in" class="form-label fw-bold">Check-in</label>
        <input id="check-in" name="checkIn" type="date" class="form-control" required>
      </div>
      <div class="col-12 col-sm-6">
        <label for="check-out" class="form-label fw-bold">Check-out</label>
        <input id="check-out" name="checkOut" type="date" class="form-control" required>
      </div>
      <div class="col-12">
        <button id="pay-btn" type="button" data-listing-id="<%= listing._id %>" class="btn btn-danger">Book Now</button>
        <p id="booking-error" class="text-danger mt-2 mb-0" role="alert" hidden></p>
      </div>
    </form>
    <% } 
    else { %>
    <!-- If user is NOT logged in, redirect them to the login page -->
    <a href="/login" class="btn btn-danger mt-3">Login to Book</a>
    <% } %>

<% if( currUser && currUser._id.equals(listing.owner._id ||listing.owner))
  {%>
<div class="listing-actions">
<a href="/listings/<%=listing._id %>/edit" class="btn btn-dark w-auto "> Edit </a>
 <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE"class="m-0">
 <button type="submit" class="btn btn-dark w-auto">Delete</button>
  </form>
</div>
  <%}%>
  <!-- review -->
   <hr class="my-4" />
   <section class="review-section">
  <h4 class="fs-4"><b>Rating and reviews</b></h4>
  <% if (currUser) { %>
  <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">



  <div class="mb-3 mt-3" >
  <div>
   <label  class="form-label fw-bold" for="rating">RATING</label>
   <input type="range" min="1" max="5" id="rating" name="review[rating]">
   </div>

  <div>
   <label for="Comments" class="form-label fw-bold">Comments</label>
   <textarea name="review[comment]" id="cmment" cols="30" rows="5" class="form-control" required >
   </textarea>
   </div>

 <div class="invalid-feedback">  please Submit some comment for review</div>
  <button class="btn btn-outline- btn-dark">Submit</button>
 </div>
 </form>
 <% } else { %>
   <p><a href="/login">Log in</a> to leave a review.</p>
 <% } %>


 <!-- //Use for showing the review which is added through the form button.  -->

<h4>All Reviews</h4>
<% for (let review of listing.reviews) { %>
  <div class="review-card">
    <p class="mb-2">Rating: <%= review.rating %> / 5</p>
    <p class="mb-0"><%= review.comment %></p>
  </div>
<% } %>
   </section>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script src="/js/payment.js"></script>