    <h3>All Listings</h3>
     <!-- <form method="GET" action="/listings/new">
      <button>Create New Listing</button>
    </form>  -->

<!-- All Listing Section -->

<div class="card-container row row-cols-lg-3 row-cols-md-3 row-cols-sm-1 g-4">
<% for(let listing of allListings) 
    { %>
        <!-- Making clickable card by wrapping in side anchor tag. -->
 <a href="/listings/<%= listing._id %>" class="listing-link">
   <div class="card col listing-card"  style="width: 20rem">
   <img src="<%= listing.image.url %>"
   class="card-img-top" 
   alt="listing_image" 
   style="height:18rem;"/>
    
         <!-- Overlay Effect on Card -->
        <div class="card-img-overlay"></div>
        <div class="card-body">
        <h6 class="card-title"><%= listing.title %></h6>
          <p class="card-text">
        &#8377;<%= listing.price != null ?  listing.price.toLocaleString("en-IN") : "N/A"  %><span> per guest</span>
         <small><i class="tax-info">&nbsp;&nbsp;&nbsp;&nbsp;+18% GST</i></small>  
         </p>   
     </div>
 </div>
 </a>

<% }  %>
     
    </div>

  </body>