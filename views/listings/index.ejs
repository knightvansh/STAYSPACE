<% layout("layouts/boilerplate") %>

<section class="listing-explorer" aria-labelledby="listing-heading">
  <div class="listing-hero">
    <span class="listing-eyebrow"><i class="fa-solid fa-compass" aria-hidden="true"></i> Find your next escape</span>
    <h1 id="listing-heading">Stays that make the trip</h1>
    <p>Explore places worth travelling for, from city hideaways to quiet retreats.</p>
  </div>

  <form class="listing-filters" action="/listings" method="GET" aria-label="Filter listings">
    <div class="filter-field filter-search-field">
      <label for="listing-search">Destination or stay</label>
      <div class="filter-input-wrap">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <input
          id="listing-search"
          class="form-control"
          type="search"
          name="search"
          value="<%= search %>"
          placeholder="Try a city, country, or stay"
        >
      </div>
    </div>

    <div class="filter-field">
      <label for="listing-country">Country</label>
      <select id="listing-country" class="form-select" name="country">
        <option value="">Anywhere</option>
        <% for (const country of countries) { %>
          <option value="<%= country %>" <%= selectedCountry === country ? "selected" : "" %>><%= country %></option>
        <% } %>
      </select>
    </div>

    <div class="filter-field">
      <label for="minimum-price">Minimum price</label>
      <div class="price-input-wrap">
        <span aria-hidden="true">&#8377;</span>
        <input
          id="minimum-price"
          class="form-control"
          type="number"
          name="minPrice"
          min="0"
          step="0.01"
          value="<%= minPrice %>"
          placeholder="Any"
        >
      </div>
    </div>

    <div class="filter-field">
      <label for="maximum-price">Maximum price</label>
      <div class="price-input-wrap">
        <span aria-hidden="true">&#8377;</span>
        <input
          id="maximum-price"
          class="form-control"
          type="number"
          name="maxPrice"
          min="0"
          step="0.01"
          value="<%= maxPrice %>"
          placeholder="Any"
        >
      </div>
    </div>

    <div class="filter-actions">
      <button class="filter-apply" type="submit">
        <i class="fa-solid fa-sliders" aria-hidden="true"></i>
        <span>Apply filters</span>
      </button>
      <a class="filter-reset" href="/listings">Reset</a>
    </div>
  </form>

  <div class="listing-results" aria-live="polite">
    <strong><%= allListings.length %></strong>
    <%= allListings.length === 1 ? "stay" : "stays" %> found
  </div>

  <% if (allListings.length) { %>
    <div class="card-container row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
      <% for (const listing of allListings) { %>
        <a href="/listings/<%= listing._id %>" class="listing-link col">
          <article class="card listing-card">
            <div class="listing-image-wrap">
              <img
                src="<%= listing.image && listing.image.url ? listing.image.url : 'https://via.placeholder.com/800x600?text=StaySpace' %>"
                class="listing-index-image"
                alt="<%= listing.title %>"
                loading="lazy"
                decoding="async"
              >
              <span class="listing-image-badge"><i class="fa-solid fa-star" aria-hidden="true"></i> StaySpace</span>
            </div>
            <div class="card-body">
              <h2 class="card-title"><%= listing.title %></h2>
              <p class="listing-location">
                <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                <%= listing.location %><%= listing.country ? `, ${listing.country}` : "" %>
              </p>
              <p class="card-text">
                <strong>&#8377;<%= listing.price != null ? listing.price.toLocaleString("en-IN") : "N/A" %></strong>
                <span>per night</span>
              </p>
            </div>
          </article>
        </a>
      <% } %>
    </div>
  <% } else { %>
    <div class="listing-empty-state">
      <i class="fa-regular fa-face-meh" aria-hidden="true"></i>
      <h2>No stays match those filters</h2>
      <p>Try a different destination or widen your price range.</p>
      <a class="filter-apply" href="/listings">Show all listings</a>
    </div>
  <% } %>
</section>
