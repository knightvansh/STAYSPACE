<% layout("layouts/boilerplate") %>
<body>
    <div class="row" mt=3>
  <div class="col-8 offset-2">
    <h3> Create a new listing.</h3>
    <form method="POST" action="/listings"  class="need-validation"  novalidate   enctype="multipart/form-data">
       <div class="mb-4">
    <label for="title">Title</label><br>
    <input name="listing[title]"
     placeholder="Enter title" type="text">
     </div>
 <div class="invalid-feedback">Title required!</div>
    <br>

    <div class="mb-4">
    <label for="description" class="form-label fw-bold">Description</label><br>
    <textarea name="listing[description]" placeholder="Enter description"  class="form-control">
    </textarea>
    </div>
<div class="invalid-feedback">please enter a description. </div>
              <br>

     <div class="mb-4">
          <label for="image" class="form-label fw-bold">Upload Image</label>
             <input
                  type="file"
                 name="listing[image]"
                 id="image"
                class="form-control border border-2 border-secondary-subtle"
              required />
      </div>

<div class="mb-4">
<label for="Price" class="form-label fw-bold">Price</label><br>
<input name="listing[price]" placeholder="Enter price" required>
</div>
  <div class="invalid-feedback">Enter valid price!</div>
    <br>

  <div class="mb-4">
    <label for="Price" class="form-label fw-bold">location</label><br>
 <input name="listing[location]" placeholder="Enter location"  required >
 </div>  
 <div class="invalid-feedback">Enter valid location!</div>
    <br>

<div class="mb-4">
<label for="Price" class="form-label fw-bold">Country</label><br>
<input name="listing[country]" placeholder="Enter country" required>
</div>
 <div class="invalid-feedback">Enter valid country name!</div>
    <br><br><br><br>
 <button  class="btn btn-dark">ADD </button>
 </div>
</div>
</form>

</body>
