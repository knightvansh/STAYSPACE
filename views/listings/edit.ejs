  <% layout("layouts/boilerplate") %>
  <body>
    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT">
<div class="row" mt-3>
  <div class="col-8 offset-2">
      <h3>Edit your Listing</h3>
      <div class="mb-4">
      <label for="title">Title</label><br>
      <input name="listing[title]" value="<%= listing.title %>" type="text" />
      </div>
      <br>

    <div class="mb-4">
    <label for="description" class="form-label fw-bold">Description</label><br>
      <textarea name="listing[description]" class="form-control">
        <%= listing.description %>
      </textarea >
    </div>
      <br>

  <div class="mb-4">
          <label for="image" class="form-label fw-bold">Upload Image</label>
             <input
                  type="file"
                 name="listing[image]"
                 id="image"
                class="form-control border border-2 border-secondary-subtle"
              required />
      </div> 

<div class="mb-4">
<label for="Price" class="form-label fw-bold">Price</label><br>
  <input name="listing[price]" value="<%= listing.price %>" type="number" />
  </div>
  <br>


 <div class="mb-4">
    <label for="Price" class="form-label fw-bold">location</label><br>
   <input
        name="listing[location]"
        value="<%= listing.location %>"
        type="text"
      />
</div>
<br>


 <div class="mb-4">
    <label for="Price" class="form-label fw-bold">country</label><br>  
      <input
        name="listing[country]"
        value="<%= listing.country %>"
        type="text"
      />
  </div>
    <br>
   </div>
</div>


    <button class="edit-btn btn-dark edit btn">Edit</button>
    </form>
  </body>
</html>